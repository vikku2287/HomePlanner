# Get a key at https://console.anthropic.com/ (needed for chat, suggestions and turning notes into plans)
ANTHROPIC_API_KEY=

# Signs sign-in cookies. Required in production: at least 32 random characters,
# e.g. the output of `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
HOMEPLANNER_SESSION_SECRET=

# Shared hosted database + realtime sync (Supabase). Leave empty to use a local JSON file.
# Supabase dashboard > Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional overrides
# HOMEPLANNER_MODEL=claude-opus-5-5
# HOMEPLANNER_DATA_FILE=./data/homeplanner.json
